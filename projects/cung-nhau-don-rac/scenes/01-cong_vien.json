  "dialogue": [
    {
      "id": "l1",
      "voice": "voice_vi_female",
      "text": "Chiều thứ bảy, nhóm Bé Tí, Bé Bơ, Bé Mít ra công viên chơi thì gặp nhóm Bé Tũn và Bé Bông.",
      "start": 4
    },
    {
      "id": "l2",
      "speaker": "ti",
      "to": "tun",
      "emotion": "happy",
      "pan": 0.25,
      "text": "Chào Tũn, chào Bông! Chơi cùng tụi mình nhé!",
      "start": {
        "after": "l1",
        "gap": 0.45
      }
    },
    {
      "id": "l3",
      "speaker": "tun",
      "to": "ti",
      "emotion": "happy",
      "pan": -0.12,
      "text": "Hay quá! Mình chơi đuổi bắt đi!",
      "start": {
        "after": "l2",
        "gap": 0.45
      }
    },
    {
      "id": "l4_v",
      "speaker": "bong",
      "to": "mit",
      "emotion": "happy",
      "pan": -0.25,
      "text": "Hi hi hi!",
      "subtitle": false,
      "start": {
        "after": "l3",
        "gap": 11.38
      }
    },
    {
      "id": "l4",
      "speaker": "bong",
      "to": "mit",
      "emotion": "happy",
      "pan": -0.25,
      "text": "Bắt được Mít rồi nhé!",
      "start": {
        "after": "l4_v",
        "gap": 0.12
      }
    },
    {
      "id": "l5_v",
      "speaker": "bo",
      "to": "bong",
      "emotion": "happy",
      "pan": 0.13,
      "text": "Haizz…",
      "subtitle": false,
      "start": {
        "after": "l4",
        "gap": 0.45
      }
    },
    {
      "id": "l5",
      "speaker": "bo",
      "to": "bong",
      "emotion": "happy",
      "pan": 0.13,
      "text": "Chạy mệt quá! Để mình uống hết chai nước đã.",
      "start": {
        "after": "l5_v",
        "gap": 0.12
      }
    },
    {
      "id": "l6",
      "voice": "voice_vi_female",
      "text": "Uống xong, Bơ tiện tay vứt luôn vỏ chai xuống bãi cỏ.",
      "start": {
        "after": "l5",
        "gap": 1.95
      }
    },
    {
      "id": "l7_v",
      "speaker": "bong",
      "to": "bo",
      "emotion": "surprised",
      "pan": -0.25,
      "text": "Ối!",
      "subtitle": false,
      "start": {
        "after": "l6",
        "gap": 0.45
      }
    },
    {
      "id": "l7",
      "speaker": "bong",
      "to": "bo",
      "emotion": "surprised",
      "pan": -0.25,
      "text": "Ơ kìa Bơ, sao cậu lại vứt rác bừa bãi thế?",
      "start": {
        "after": "l7_v",
        "gap": 0.12
      }
    },
    {
      "id": "l8",
      "speaker": "bo",
      "to": "bong",
      "pan": 0.13,
      "text": "Có một cái vỏ chai thôi mà, có sao đâu.",
      "start": {
        "after": "l7",
        "gap": 0.45
      }
    },
    {
      "id": "l9_v",
      "speaker": "mit",
      "to": "ti",
      "emotion": "sad",
      "pan": 0.13,
      "text": "Ui da!",
      "subtitle": false,
      "start": {
        "after": "l8",
        "gap": 2.13
      }
    },
    {
      "id": "l9",
      "speaker": "mit",
      "to": "ti",
      "emotion": "sad",
      "pan": 0.13,
      "text": "Ui da! Mình vấp phải cái chai rồi!",
      "start": {
        "after": "l9_v",
        "gap": 0.12
      }
    },
    {
      "id": "l10",
      "speaker": "ti",
      "to": "bo",
      "emotion": "surprised",
      "pan": 0.25,
      "text": "Mít có đau không? Đấy Bơ thấy chưa, rác vứt bừa làm bạn bị ngã đấy.",
      "start": {
        "after": "l9",
        "gap": 0.45
      }
    },
    {
      "id": "l11",
      "speaker": "bong",
      "to": "tun",
      "pan": 0.05,
      "text": "Mình nhặt cái chai này lên đã.",
      "start": {
        "after": "l10",
        "gap": 5.05
      }
    },
    {
      "id": "l12",
      "speaker": "tun",
      "to": "bong",
      "pan": -0.12,
      "text": "Bơ đi với tụi mình ra ao, xem rác đi về đâu nhé.",
      "start": {
        "after": "l11",
        "gap": 5.35
      }
    }
  ],
