  "dialogue": [
    {
      "id": "l29",
      "voice": "voice_vi_female",
      "text": "Mặt trời dần lặn. Các bạn vui vẻ cùng nhau đi về nhà.",
      "start": 4
    },
    {
      "id": "l30",
      "speaker": "bong",
      "to": "bo",
      "emotion": "happy",
      "pan": -0.22,
      "text": "Hôm nay vui quá! Mai tụi mình lại ra công viên chơi tiếp nhé!",
      "start": {
        "after": "l29",
        "gap": 0.45
      }
    },
    {
      "id": "l31",
      "speaker": "bo",
      "to": "bong",
      "emotion": "happy",
      "pan": -0.19,
      "text": "Cảm ơn các bạn đã nhắc mình nhé!",
      "start": {
        "after": "l30",
        "gap": 6.15
      }
    },
    {
      "id": "l32",
      "voice": "voice_vi_female",
      "text": "Các bé ơi, hãy luôn bỏ rác đúng nơi quy định để giữ môi trường xanh, sạch, đẹp nhé!",
      "start": {
        "after": "l31",
        "gap": 0.45
      }
    },
    {
      "id": "l33",
      "speaker": "ti",
      "to": "bo",
      "emotion": "happy",
      "pan": 0.22,
      "text": "Tạm biệt! Mình về nhà thôi!",
      "start": {
        "after": "l32",
        "gap": 0.45
      }
    }
  ],
