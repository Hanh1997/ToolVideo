{
  "version": 1,
  "meta": {
    "name": "Học đếm đến ba",
    "duration": "auto",
    "tail": 1.5,
    "fps": 30,
    "width": 1280,
    "height": 720
  },
  "environment": {
    "asset": "env_meadow",
    "background": "#a8d8f0",
    "fog": {
      "color": "#a8d8f0",
      "near": 30,
      "far": 70
    }
  },
  "characters": [
    {
      "id": "host",
      "asset": "char_robot",
      "position": {
        "x": 0,
        "y": 0,
        "z": 2
      },
      "heading": 180,
      "voice": "voice_vi_female"
    }
  ],
  "props": [
    {
      "id": "log",
      "asset": "prop_log",
      "position": {
        "x": 1.8,
        "y": 0,
        "z": 3
      },
      "heading": 30
    }
  ],
  "camera": {
    "mode": "fixed",
    "position": {
      "x": 1.2,
      "y": 1.7,
      "z": -3.2
    },
    "lookAt": {
      "x": 0,
      "y": 1.1,
      "z": 2
    },
    "fov": 45
  },
  "subtitles": {
    "burnIn": true,
    "size": 0.055,
    "position": "bottom"
  },
  "mix": {
    "duckMusic": true,
    "duckLevel": 0.3,
    "loudness": -14
  },
  "dialogue": [
    {
      "id": "l1",
      "speaker": "host",
      "text": "Xin chào các bạn nhỏ! Mình là Rô-bốt Vàng.",
      "start": 0.6
    },
    {
      "id": "l2",
      "speaker": "host",
      "text": "Hôm nay chúng mình cùng học đếm đến ba nhé.",
      "start": {
        "after": "l1",
        "gap": 0.5
      }
    },
    {
      "id": "l3",
      "speaker": "host",
      "text": "Một, hai, ba! Các bạn giỏi quá!",
      "start": {
        "after": "l2",
        "gap": 0.5
      }
    }
  ],
  "actions": [
    {
      "id": "anim_greet",
      "type": "animation",
      "target": "host",
      "clip": "wave",
      "loop": false,
      "sync": {
        "line": "l1",
        "offset": -0.3,
        "pad": 0.2
      }
    },
    {
      "id": "anim_2",
      "type": "animation",
      "target": "host",
      "clip": "yes",
      "sync": {
        "line": "l2"
      }
    },
    {
      "id": "anim_3",
      "type": "animation",
      "target": "host",
      "clip": "thumbsup",
      "loop": false,
      "sync": {
        "line": "l3",
        "pad": 0.3
      }
    },
    {
      "id": "cam_close",
      "type": "camera",
      "sync": {
        "line": "l3",
        "offset": -0.2,
        "pad": 30
      },
      "shot": {
        "mode": "fixed",
        "position": {
          "x": 0.7,
          "y": 1.35,
          "z": -0.9
        },
        "lookAt": {
          "x": 0,
          "y": 0.95,
          "z": 2
        },
        "fov": 42
      }
    }
  ],
  "audio": [
    {
      "id": "bgm",
      "kind": "music",
      "asset": "music_happy",
      "start": 0,
      "loop": true,
      "volume": 0.5,
      "fadeIn": 0.3,
      "fadeOut": 1.2
    },
    {
      "id": "sfx_end",
      "kind": "sfx",
      "asset": "sfx_chime",
      "sync": {
        "line": "l3",
        "at": "end",
        "offset": 0.1
      },
      "volume": 0.8
    }
  ]
}
