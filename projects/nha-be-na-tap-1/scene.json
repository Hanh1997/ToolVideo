  "dialogue": [
    {
      "id": "l1",
      "voice": "voice_vi_soft",
      "text": "Đây là nhà của bé Na. Bé Na rất thích chơi đồ chơi cùng bạn Cún.",
      "start": 1.5
    },
    {
      "id": "l2",
      "speaker": "na",
      "to": "cun",
      "text": "Cún ơi, đuổi theo tớ nào!",
      "emotion": "happy",
      "start": {
        "after": "l1",
        "gap": 7.28
      }
    },
    {
      "id": "l3",
      "speaker": "cun",
      "to": "na",
      "text": "Gâu gâu! Bắt được Na rồi nhé!",
      "emotion": "happy",
      "start": {
        "after": "l2",
        "gap": 2.48
      }
    },
    {
      "id": "l4",
      "speaker": "me",
      "to": "na",
      "text": "Na ơi, chơi xong con nhớ cất đồ chơi vào hộp nhé.",
      "start": {
        "after": "l3",
        "gap": 0.45
      }
    },
    {
      "id": "l5",
      "speaker": "na",
      "to": "bo",
      "text": "Dạ, lát nữa con cất ạ!",
      "start": {
        "after": "l4",
        "gap": 0.45
      }
    },
    {
      "id": "l6",
      "speaker": "na",
      "to": "bo",
      "text": "Ối! Đau quá!",
      "emotion": "scared",
      "start": {
        "after": "l5",
        "gap": 2.23
      }
    },
    {
      "id": "l7",
      "speaker": "bo",
      "to": "na",
      "text": "Con gái có sao không? Để bố xem nào.",
      "emotion": "surprised",
      "start": {
        "after": "l6",
        "gap": 8.15
      }
    },
    {
      "id": "l8",
      "speaker": "na",
      "to": "me",
      "text": "Tại con không nghe lời mẹ... Con xin lỗi ạ.",
      "emotion": "sad",
      "start": {
        "after": "l7",
        "gap": 5.22
      }
    },
    {
      "id": "l9",
      "speaker": "me",
      "to": "na",
      "text": "Không sao đâu con. Mình cùng dọn nhé!",
      "emotion": "happy",
      "start": {
        "after": "l8",
        "gap": 4.32
      }
    },
    {
      "id": "l10",
      "speaker": "na",
      "to": "me",
      "text": "Bạn gấu ơi, về nhà thôi!",
      "emotion": "happy",
      "start": {
        "after": "l9",
        "gap": 5.82
      }
    },
    {
      "id": "l11",
      "speaker": "na",
      "to": "me",
      "text": "Xong rồi! Phòng gọn gàng quá!",
      "emotion": "happy",
      "start": {
        "after": "l10",
        "gap": 3.96
      }
    },
    {
      "id": "l12",
      "voice": "voice_vi_soft",
      "text": "Chơi xong tự cất đồ chơi, nhà mình luôn gọn gàng và an toàn.",
      "start": {
        "after": "l11",
        "gap": 3.1
      }
    }
  ],
