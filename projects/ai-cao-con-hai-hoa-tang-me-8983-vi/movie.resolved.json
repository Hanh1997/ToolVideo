        "dialogue": [
          {
            "id": "l1",
            "text": "Một buổi sáng đẹp trời, Cáo con ở nông trại nhớ đến sinh nhật mẹ.",
            "start": 4,
            "duration": 3.46,
            "file": "tts/4d233a2146fc2428005e4f82.wav",
            "voice": "voice_vi_female",
            "rate": 0.9,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l2",
            "speaker": "fox",
            "text": "Hôm nay là sinh nhật mẹ, con sẽ ra đồng hoa hái bông hoa đẹp nhất!",
            "start": 7.91,
            "duration": 3.088,
            "file": "tts/f832049b59581aaa28a25776.wav",
            "voice": "voice_vi_squeaky",
            "rate": 1,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l3",
            "speaker": "mom",
            "text": "Ý tưởng tuyệt vời! Nhưng con đi cẩn thận nhé.",
            "start": 11.448,
            "duration": 2.09,
            "file": "tts/9ef17a4b27c428e981fdbb94.wav",
            "voice": "voice_vi_female",
            "rate": 0.9,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l4",
            "speaker": "fox",
            "text": "Con sẽ về sớm thôi mẹ ạ!",
            "start": 13.988,
            "duration": 1.265,
            "file": "tts/a61b53de245829b9551b7ee6.wav",
            "voice": "voice_vi_squeaky",
            "rate": 1,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l5",
            "text": "Cáo con vui vẻ rời nông trại, đi về phía đồng hoa.",
            "start": 15.703,
            "duration": 2.577,
            "file": "tts/37b047c624eeee614b31d3b8.wav",
            "voice": "voice_vi_female",
            "rate": 0.9,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l6",
