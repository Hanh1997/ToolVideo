        "dialogue": [
          {
            "id": "l13",
            "text": "Trên đường về, Cáo con gặp Thỏ con bên ao ô nhiễm. Mẹ Cáo cũng vừa đến tìm con.",
            "start": 4,
            "duration": 4.319,
            "file": "tts/d1809ab0e05693f03686fc59.wav",
            "voice": "voice_vi_female",
            "rate": 0.9,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l14",
            "speaker": "bunny",
            "text": "Cáo ơi, ao có nhiều rác quá, tớ đang nhặt rác đây.",
            "start": 8.769,
            "duration": 2.798,
            "file": "tts/79f1627fac36af7dca50788c.wav",
            "voice": "voice_vi_child",
            "rate": 0.95,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l15",
            "speaker": "bunny",
            "text": "Tớ nhặt chai nhựa này trước nhé!",
            "start": 18.137,
            "duration": 1.683,
            "file": "tts/cf2e644f691bd72372a887d1.wav",
            "voice": "voice_vi_child",
            "rate": 0.95,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l16",
            "speaker": "fox",
            "text": "Mẹ ơi, con tặng mẹ bông hoa đẹp nhất!",
            "start": 26.31,
            "duration": 1.892,
            "file": "tts/fffd73ef8e89ac6ae94eaafe.wav",
            "voice": "voice_vi_squeaky",
            "rate": 1,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l17",
            "speaker": "mom",
            "text": "Cáo con, con làm gì thế?",
            "start": 28.652,
            "duration": 1.405,
            "file": "tts/9612dc17b44886eddb2a0dac.wav",
            "voice": "voice_vi_female",
            "rate": 0.9,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l18",
            "speaker": "fox",
            "text": "Con cũng nhặt rác giúp Thỏ ạ!",
            "start": 34.267,
            "duration": 1.382,
            "file": "tts/d2b92bca491d156a9daaa8ca.wav",
            "voice": "voice_vi_squeaky",
            "rate": 1,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l19",
            "speaker": "bunny",
            "text": "Bảo vệ môi trường là việc tốt! Cùng nhảy mừng ao sạch nào!",
            "start": 36.099,
            "duration": 2.747,
            "file": "tts/c3bf7dd8b9005be0cc471b34.wav",
            "voice": "voice_vi_child",
            "rate": 0.95,
            "volume": 1,
            "subtitle": true
          }
        ],
