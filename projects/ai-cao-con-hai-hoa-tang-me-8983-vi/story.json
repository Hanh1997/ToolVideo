        {
          "id": "l1",
          "speaker": null,
          "gesture": null,
          "text": {
            "vi": "Một buổi sáng đẹp trời, Cáo con ở nông trại nhớ đến sinh nhật mẹ."
          },
          "action": null
        },
        {
          "id": "l2",
          "speaker": "fox",
          "gesture": "thumbsup",
          "text": {
            "vi": "Hôm nay là sinh nhật mẹ, con sẽ ra đồng hoa hái bông hoa đẹp nhất!"
          },
          "action": null
        },
        {
          "id": "l3",
          "speaker": "mom",
          "gesture": null,
          "text": {
            "vi": "Ý tưởng tuyệt vời! Nhưng con đi cẩn thận nhé."
