  "dialogue": [
    {
      "id": "l13",
      "voice": "voice_vi_female",
      "text": "Trên đường về, Cáo con gặp Thỏ con bên ao ô nhiễm. Mẹ Cáo cũng vừa đến tìm con.",
      "start": 4
    },
    {
      "id": "l14",
      "speaker": "bunny",
      "text": "Cáo ơi, ao có nhiều rác quá, tớ đang nhặt rác đây.",
      "start": {
        "after": "l13",
        "gap": 0.45
      }
    },
    {
      "id": "l15",
      "speaker": "bunny",
      "text": "Tớ nhặt chai nhựa này trước nhé!",
      "start": {
        "after": "l14",
        "gap": 6.57
      }
    },
    {
      "id": "l16",
      "speaker": "fox",
      "text": "Mẹ ơi, con tặng mẹ bông hoa đẹp nhất!",
      "start": {
        "after": "l15",
        "gap": 6.49
      }
    },
    {
      "id": "l17",
      "speaker": "mom",
      "text": "Cáo con, con làm gì thế?",
      "start": {
        "after": "l16",
        "gap": 0.45
      }
    },
    {
      "id": "l18",
      "speaker": "fox",
      "text": "Con cũng nhặt rác giúp Thỏ ạ!",
      "start": {
        "after": "l17",
        "gap": 4.21
      }
    },
    {
      "id": "l19",
      "speaker": "bunny",
      "text": "Bảo vệ môi trường là việc tốt! Cùng nhảy mừng ao sạch nào!",
      "start": {
        "after": "l18",
        "gap": 0.45
      }
    }
  ],
