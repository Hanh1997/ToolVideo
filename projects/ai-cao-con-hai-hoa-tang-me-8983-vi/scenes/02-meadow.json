  "dialogue": [
    {
      "id": "l7",
      "voice": "voice_vi_female",
      "text": "Cáo con đến đồng hoa rộng lớn, ngập tràn hoa đủ màu sắc.",
      "start": 4
    },
    {
      "id": "l8",
      "speaker": "fox",
      "text": "Ôi, bông hoa đỏ kia đẹp quá!",
      "start": {
        "after": "l7",
        "gap": 4.47
      }
    },
    {
      "id": "l9",
      "speaker": "fox",
      "text": "Mình sẽ mang bông hoa này về tặng mẹ nhân ngày sinh nhật.",
      "start": {
        "after": "l8",
        "gap": 0.45
      }
    },
    {
      "id": "l10",
      "voice": "voice_vi_female",
      "text": "Cáo con rời đồng hoa, trở về nông trại với bông hoa trên tay.",
      "start": {
        "after": "l9",
        "gap": 0.45
      }
    },
    {
      "id": "l11",
      "speaker": "fox",
      "text": "Mẹ sẽ rất thích món quà này!",
      "start": {
        "after": "l10",
        "gap": 0.45
      }
    },
    {
      "id": "l12",
      "voice": "voice_vi_female",
      "text": "Trên đường về, Cáo con vẫn giữ chặt bông hoa đẹp.",
      "start": {
        "after": "l11",
        "gap": 0.45
      }
    }
