  "dialogue": [
    {
      "id": "l1",
      "voice": "voice_vi_female",
      "text": "Một buổi sáng đẹp trời, Cáo con ở nông trại nhớ đến sinh nhật mẹ.",
      "start": 4
    },
    {
      "id": "l2",
      "speaker": "fox",
      "text": "Hôm nay là sinh nhật mẹ, con sẽ ra đồng hoa hái bông hoa đẹp nhất!",
      "start": {
        "after": "l1",
        "gap": 0.45
      }
    },
    {
      "id": "l3",
      "speaker": "mom",
      "text": "Ý tưởng tuyệt vời! Nhưng con đi cẩn thận nhé.",
      "start": {
        "after": "l2",
        "gap": 0.45
      }
    },
    {
      "id": "l4",
      "speaker": "fox",
      "text": "Con sẽ về sớm thôi mẹ ạ!",
      "start": {
        "after": "l3",
        "gap": 0.45
      }
    },
    {
      "id": "l5",
      "voice": "voice_vi_female",
      "text": "Cáo con vui vẻ rời nông trại, đi về phía đồng hoa.",
      "start": {
        "after": "l4",
        "gap": 0.45
      }
    },
    {
      "id": "l6",
      "speaker": "mom",
      "text": "Chúc con tìm được bông hoa đẹp nhất!",
      "start": {
        "after": "l5",
        "gap": 0.45
      }
    }
  ],
