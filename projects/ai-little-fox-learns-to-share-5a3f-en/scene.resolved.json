  "dialogue": [
    {
      "id": "l1",
      "text": "In a sunny forest, Little Fox found a big basket of sweet berries.",
      "start": 4,
      "duration": 5.155,
      "file": "tts/fbea1785af0c54da2b1e45eb.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l2",
      "speaker": "fox",
      "text": "Wow! These berries look delicious!",
      "start": 9.605,
      "duration": 2.206,
      "file": "tts/e5cc5634d32d2105c9ae02ca.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l3",
      "speaker": "bunny",
      "text": "Hello, Fox! May I please have one berry?",
      "start": 12.261,
      "duration": 3.03,
      "file": "tts/e54ba877f1bb74a037754825.wav",
      "voice": "voice_en_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l4",
      "speaker": "fox",
      "text": "No, these are all mine!",
      "start": 15.741,
      "duration": 1.591,
      "file": "tts/1431c1a0c2cf49c1b1baf112.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l5",
      "speaker": "deer",
      "text": "Sharing a snack is more fun, Fox.",
      "start": 17.782,
      "duration": 3.065,
      "file": "tts/30249746f4979199969bb31c.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l6",
      "speaker": "fox",
      "text": "I said no! Go play somewhere else.",
      "start": 21.297,
      "duration": 2.67,
      "file": "tts/18e96d9fa40bd0aa369e5fb8.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l7",
      "speaker": "bunny",
      "text": "That hurts my feelings, Fox.",
      "start": 24.417,
      "duration": 1.985,
      "file": "tts/cdd6470e7b38dff51d2072ee.wav",
      "voice": "voice_en_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l8",
      "speaker": "deer",
      "text": "Friends are kind to each other.",
      "start": 26.852,
      "duration": 1.974,
      "file": "tts/199c1f6d4f0ac21858267506.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l9",
      "speaker": "fox",
      "text": "But I found the berries first!",
      "start": 29.276,
      "duration": 1.773,
      "file": "tts/a8de994f50fa7afc31a22253.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l10",
      "text": "Little Fox sat alone with his basket, but he felt lonely inside.",
      "start": 31.499,
      "duration": 4.969,
      "file": "tts/7617fea7dba40d1243974c91.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l11",
      "speaker": "fox",
      "text": "Why do I feel sad when I have all the berries?",
      "start": 36.918,
      "duration": 2.422,
      "file": "tts/a35094a09f450427c508746d.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l12",
      "speaker": "bunny",
      "text": "Because being together with friends is the sweetest treat.",
      "start": 39.79,
      "duration": 3.274,
      "file": "tts/bc39f616cb2ff179938bbb5e.wav",
      "voice": "voice_en_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l13",
      "speaker": "deer",
      "text": "We picked some nuts for you, Fox. Let's share everything!",
      "start": 43.514,
      "duration": 3.727,
      "file": "tts/140352b2a2f72be1a70345d5.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l14",
      "speaker": "fox",
      "text": "You want to share with me, even after I was unkind?",
      "start": 47.691,
      "duration": 3.274,
      "file": "tts/7b6c1a44b81d91ff91b34b59.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l15",
      "speaker": "bunny",
      "text": "Of course! Friends forgive and share.",
      "start": 51.415,
      "duration": 2.514,
      "file": "tts/9c6a13b919446785ca251963.wav",
      "voice": "voice_en_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l16",
      "speaker": "fox",
      "text": "I am sorry. Please, let's have a berry and nut picnic together!",
      "start": 54.379,
      "duration": 3.982,
      "file": "tts/a3ec0d92f20246eec1c90b03.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l17",
      "speaker": "deer",
      "text": "Hooray! Sharing makes the food taste better!",
      "start": 58.811,
      "duration": 2.949,
      "file": "tts/e96115a3998c9fa733347e4c.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l18",
      "speaker": "bunny",
      "text": "This is the best picnic ever!",
      "start": 62.21,
      "duration": 1.521,
      "file": "tts/dd9d0d96d862e33c8ae39dee.wav",
      "voice": "voice_en_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l19",
      "speaker": "fox",
      "text": "Thank you for teaching me about friendship.",
      "start": 64.181,
      "duration": 2.299,
      "file": "tts/e61b1860acc69cdcfde1365a.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l20",
      "speaker": "deer",
      "text": "Sharing is caring, Fox.",
      "start": 66.93,
      "duration": 1.974,
      "file": "tts/58e2c285ea58c740186d6e82.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l21",
      "speaker": "fox",
      "text": "Now I know: sharing fills our hearts with joy.",
      "start": 69.354,
      "duration": 3.46,
      "file": "tts/2aca5956c773d281ad8f3354.wav",
      "voice": "voice_en_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l22",
      "speaker": "bunny",
      "text": "And playing together is always better!",
      "start": 73.264,
      "duration": 2.159,
      "file": "tts/5544eea64127e53fd8c4c87e.wav",
      "voice": "voice_en_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l23",
      "text": "Little Fox learned that sharing is a wonderful way to show love.",
      "start": 75.873,
      "duration": 4.11,
      "file": "tts/87f337fc169cb917b7e25e2a.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l24",
      "text": "Let's all dance and celebrate being good friends!",
      "start": 80.433,
      "duration": 3.262,
      "file": "tts/960527cb76f0f1a110f841b3.wav",
      "voice": "voice_en_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    }
  ],
