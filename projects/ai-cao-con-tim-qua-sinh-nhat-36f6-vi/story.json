  "title": {
    "vi": "Cáo Con Tìm Quà Sinh Nhật"
  },
  "summary": {
    "vi": "Cáo con rời nông trại, băng qua rừng thu đến đồng hoa tìm quà sinh nhật cho mẹ. Trên đường, bé gặp bạn thỏ bị lạc và học được niềm vui khi giúp đỡ bạn bè."
  },
  "music": true,
  "narratorVoice": "female",
  "ending": "dance",
  "characters": [
    {
      "id": "fox_con",
      "asset": "char_k_animal_fox",
      "voice": "child",
      "name": {
        "vi": "Cáo Con"
      }
    },
    {
      "id": "tho_con",
      "asset": "char_k_animal_bunny",
      "voice": "squeaky",
      "name": {
        "vi": "Thỏ Con"
      }
    }
  ],
  "scenes": [
    {
      "id": "nong_trai",
      "environment": "env_farm",
      "cast": [
        "fox_con"
      ],
      "transition": "cut",
      "lines": [
        {
          "id": "l1",
          "speaker": null,
          "gesture": null,
          "text": {
            "vi": "Cáo Con chào tạm biệt nông trại, lên đường tìm quà sinh nhật cho mẹ."
          }
        },
        {
          "id": "l2",
          "speaker": "fox_con",
          "gesture": "yes",
          "text": {
            "vi": "Con muốn tìm bông hoa đẹp nhất để tặng mẹ."
          }
        },
        {
          "id": "l3",
          "speaker": null,
          "gesture": null,
          "text": {
            "vi": "Cáo Con vui vẻ rời nông trại, tiến vào rừng thu."
          }
        },
        {
          "id": "l4",
          "speaker": "fox_con",
          "gesture": "thumbsup",
          "text": {
            "vi": "Con sẽ cố gắng thật nhiều!"
          }
        }
      ]
    },
    {
      "id": "rung_thu",
      "environment": "env_autumn_forest",
      "cast": [
        "fox_con",
        "tho_con"
      ],
      "transition": "fade",
      "lines": [
        {
          "id": "l5",
          "speaker": null,
          "gesture": null,
          "text": {
            "vi": "Trong rừng thu, lá vàng rơi nhẹ khắp lối mòn."
          }
        },
        {
          "id": "l6",
          "speaker": "fox_con",
          "gesture": null,
          "text": {
            "vi": "Ôi, nhiều lá quá! Mình phải đi cẩn thận."
          }
        },
        {
          "id": "l7",
          "speaker": "tho_con",
          "gesture": null,
          "text": {
            "vi": "Bạn Cáo ơi, mình bị lạc đường. Bạn giúp mình nhé?"
          }
        },
        {
          "id": "l8",
          "speaker": "fox_con",
          "gesture": "yes",
          "text": {
            "vi": "Đừng lo, mình sẽ giúp bạn tìm đường ra."
          }
        },
        {
          "id": "l9",
          "speaker": null,
          "gesture": null,
          "text": {
            "vi": "Cáo Con dẫn bạn Thỏ Con ra khỏi khu rừng thu."
          }
        },
        {
          "id": "l10",
          "speaker": "fox_con",
          "gesture": "thumbsup",
          "text": {
            "vi": "Giúp bạn xong, lòng mình vui hơn hẳn!"
          }
        }
      ]
    },
    {
      "id": "dong_hoa",
      "environment": "env_meadow",
      "cast": [
        "fox_con",
        "tho_con"
      ],
      "transition": "dissolve",
      "lines": [
        {
          "id": "l11",
          "speaker": null,
          "gesture": null,
          "text": {
            "vi": "Cuối cùng, cả hai đến đồng hoa rực rỡ sắc màu."
          }
        },
        {
          "id": "l12",
          "speaker": "tho_con",
          "gesture": "thumbsup",
          "text": {
            "vi": "Hoa ở đây đẹp quá! Cảm ơn bạn đã giúp mình."
          }
        },
        {
          "id": "l13",
          "speaker": "fox_con",
          "gesture": "yes",
          "text": {
            "vi": "Mình sẽ chọn bông hoa đẹp nhất để tặng mẹ."
          }
        },
        {
          "id": "l14",
          "speaker": "fox_con",
          "gesture": "dance",
          "text": {
            "vi": "Mẹ ơi, con yêu mẹ! Chúc mừng sinh nhật mẹ!"
          }
        },
        {
          "id": "l15",
          "speaker": null,
          "gesture": null,
          "text": {
            "vi": "Cáo Con học được rằng giúp đỡ bạn bè làm trái tim thêm ấm áp."
          }
        }
      ]
    }
  ]
}
