      "text": "Cuối cùng, cả hai đến đồng hoa rực rỡ sắc màu.",
      "start": 4
    },
    {
      "id": "l12",
      "speaker": "tho_con",
      "text": "Hoa ở đây đẹp quá! Cảm ơn bạn đã giúp mình.",
      "start": {
        "after": "l11",
        "gap": 0.45
      }
    },
    {
      "id": "l13",
      "speaker": "fox_con",
      "text": "Mình sẽ chọn bông hoa đẹp nhất để tặng mẹ.",
      "start": {
        "after": "l12",
        "gap": 0.45
      }
    },
    {
      "id": "l14",
      "speaker": "fox_con",
      "text": "Mẹ ơi, con yêu mẹ! Chúc mừng sinh nhật mẹ!",
      "start": {
        "after": "l13",
        "gap": 0.45
      }
    },
    {
      "id": "l15",
      "voice": "voice_vi_female",
      "text": "Cáo Con học được rằng giúp đỡ bạn bè làm trái tim thêm ấm áp.",
      "start": {
        "after": "l14",
        "gap": 0.45
      }
    }
