  "dialogue": [
    {
      "id": "l5",
      "voice": "voice_vi_female",
      "text": "Trong rừng thu, lá vàng rơi nhẹ khắp lối mòn.",
      "start": 4
    },
    {
      "id": "l6",
      "speaker": "fox_con",
      "text": "Ôi, nhiều lá quá! Mình phải đi cẩn thận.",
      "start": {
        "after": "l5",
        "gap": 0.45
      }
    },
    {
      "id": "l7",
      "speaker": "tho_con",
      "text": "Bạn Cáo ơi, mình bị lạc đường. Bạn giúp mình nhé?",
      "start": {
        "after": "l6",
        "gap": 0.45
      }
    },
    {
      "id": "l8",
      "speaker": "fox_con",
      "text": "Đừng lo, mình sẽ giúp bạn tìm đường ra.",
      "start": {
        "after": "l7",
        "gap": 0.45
      }
    },
    {
      "id": "l9",
      "voice": "voice_vi_female",
      "text": "Cáo Con dẫn bạn Thỏ Con ra khỏi khu rừng thu.",
      "start": {
        "after": "l8",
        "gap": 0.45
      }
    },
    {
      "id": "l10",
      "speaker": "fox_con",
      "text": "Giúp bạn xong, lòng mình vui hơn hẳn!",
      "start": {
        "after": "l9",
        "gap": 0.45
      }
    }
  ],
