        "dialogue": [
          {
            "id": "l5",
            "text": "Trong rừng thu, lá vàng rơi nhẹ khắp lối mòn.",
            "start": 4,
            "duration": 2.461,
            "file": "tts/4007b93e5dd759ad5c5fc0c0.wav",
            "voice": "voice_vi_female",
            "rate": 0.9,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l6",
            "speaker": "fox_con",
            "text": "Ôi, nhiều lá quá! Mình phải đi cẩn thận.",
            "start": 6.911,
            "duration": 1.82,
            "file": "tts/55018bf6918db8e5269c9fc2.wav",
            "voice": "voice_vi_child",
            "rate": 0.95,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l7",
            "speaker": "tho_con",
            "text": "Bạn Cáo ơi, mình bị lạc đường. Bạn giúp mình nhé?",
            "start": 9.181,
            "duration": 2.612,
            "file": "tts/cb992811379288fdadab4b73.wav",
            "voice": "voice_vi_squeaky",
            "rate": 1,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l8",
            "speaker": "fox_con",
            "text": "Đừng lo, mình sẽ giúp bạn tìm đường ra.",
            "start": 12.243,
            "duration": 2.055,
            "file": "tts/3882cad8081367536ad02f5b.wav",
            "voice": "voice_vi_child",
            "rate": 0.95,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l9",
            "text": "Cáo Con dẫn bạn Thỏ Con ra khỏi khu rừng thu.",
            "start": 14.748,
            "duration": 2.368,
            "file": "tts/ec18487917504c6094d4fc84.wav",
            "voice": "voice_vi_female",
            "rate": 0.9,
            "volume": 1,
            "subtitle": true
          },
          {
            "id": "l10",
            "speaker": "fox_con",
            "text": "Giúp bạn xong, lòng mình vui hơn hẳn!",
            "start": 17.566,
            "duration": 2.032,
            "file": "tts/64227ba20e18cd9af20b3927.wav",
