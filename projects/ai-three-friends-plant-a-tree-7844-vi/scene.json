  "dialogue": [
    {
      "id": "l1",
      "voice": "voice_vi_female",
      "text": "Một ngày nắng đẹp ở nông trại, ba người bạn quyết định trồng một cái cây.",
      "start": 4
    },
    {
      "id": "l2",
      "speaker": "cow_01",
      "text": "Chúng ta cùng đào một cái hố nhé!",
      "start": {
        "after": "l1",
        "gap": 0.45
      }
    },
    {
      "id": "l3",
      "speaker": "piggy_01",
      "text": "Mình sẽ mang hạt giống nhỏ đến!",
      "start": {
        "after": "l2",
        "gap": 0.45
      }
    },
    {
      "id": "l4",
      "speaker": "sheep_01",
      "text": "Mình sẽ đi lấy nước từ giếng.",
      "start": {
        "after": "l3",
        "gap": 0.45
      }
    },
    {
      "id": "l5",
      "voice": "voice_vi_female",
      "text": "Họ đào đất, gieo hạt và tưới nước mỗi ngày.",
      "start": {
        "after": "l4",
        "gap": 0.45
      }
    },
    {
      "id": "l6",
      "speaker": "cow_01",
      "text": "Nhìn kìa! Hạt giống nhỏ của chúng ta đang nảy mầm!",
      "start": {
        "after": "l5",
        "gap": 0.45
      }
    },
    {
      "id": "l7",
      "speaker": "piggy_01",
      "text": "Chúng ta phải tiếp tục chăm sóc nó.",
      "start": {
        "after": "l6",
        "gap": 0.45
      }
    },
    {
      "id": "l8",
      "speaker": "sheep_01",
      "text": "Làm việc chăm chỉ sẽ giúp cây lớn khỏe.",
      "start": {
        "after": "l7",
        "gap": 0.45
      }
    },
    {
      "id": "l9",
      "voice": "voice_vi_female",
      "text": "Khi những người bạn cùng chăm chỉ, điều tuyệt vời sẽ lớn lên.",
      "start": {
        "after": "l8",
        "gap": 0.45
      }
    }
  ],
