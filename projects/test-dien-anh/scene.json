  "dialogue": [
    {
      "id": "l1",
      "voice": "voice_vi_soft",
      "text": "Sáng nay, Lan và Minh cùng mẹ ra công viên chơi.",
      "start": 3.6
    },
    {
      "id": "l2_v",
      "speaker": "lan",
      "to": "minh",
      "emotion": "surprised",
      "pan": 0.18,
      "text": "Oa!",
      "subtitle": false,
      "start": {
        "after": "l1",
        "gap": 2.29
      }
    },
    {
      "id": "l2",
      "speaker": "lan",
      "to": "minh",
      "emotion": "surprised",
      "pan": 0.18,
      "text": "Bông hoa đỏ kia đẹp quá, mình hái tặng mẹ nhé!",
      "start": {
        "after": "l2_v",
        "gap": 0.12
      }
    },
    {
      "id": "l3",
      "speaker": "minh",
      "to": "lan",
      "emotion": "happy",
      "pan": 0.1,
      "text": "Ý hay đấy, mẹ chắc chắn sẽ vui lắm cho mà xem!",
      "start": {
        "after": "l2",
        "gap": 1.5
      }
    },
    {
      "id": "l4_v",
      "speaker": "lan",
      "to": "minh",
      "emotion": "happy",
      "pan": 0.15,
      "text": "Yeah!",
      "subtitle": false,
      "start": {
        "after": "l3",
        "gap": 2.95
      }
    },
    {
      "id": "l4",
      "speaker": "lan",
      "to": "minh",
      "emotion": "happy",
      "pan": 0.15,
      "text": "Đập tay nào!",
      "start": {
        "after": "l4_v",
        "gap": 0.12
      }
    },
    {
      "id": "l5",
      "speaker": "lan",
      "to": "me",
      "emotion": "happy",
      "pan": 0.04,
      "text": "Mẹ ơi, con tặng mẹ bông hoa này ạ!",
      "start": {
        "after": "l4",
        "gap": 4.02
      }
    },
    {
      "id": "l6_v",
      "speaker": "me",
      "to": "lan",
      "emotion": "happy",
      "pan": 0.01,
      "text": "Hi hi hi!",
      "subtitle": false,
      "start": {
        "after": "l5",
        "gap": 3.25
      }
    },
    {
      "id": "l6",
      "speaker": "me",
      "to": "lan",
      "emotion": "happy",
      "pan": 0.01,
      "text": "Cảm ơn con yêu, mẹ vui lắm!",
      "start": {
        "after": "l6_v",
        "gap": 0.12
      }
    },
    {
      "id": "l7",
      "voice": "voice_vi_soft",
      "text": "Món quà nhỏ làm cả nhà thật hạnh phúc.",
      "start": {
        "after": "l6",
        "gap": 1.05
      }
    }
  ],
