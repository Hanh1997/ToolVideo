  "dialogue": [
    {
      "id": "l13",
      "voice": "voice_en_female",
      "text": "Mommy Long Legs and Bunzo walked to a beautiful flower meadow.",
      "start": 4
    },
    {
      "id": "l14",
      "speaker": "bunzo",
      "text": "Wow! So many flowers! I will pick this red one for you!",
      "emotion": "happy",
      "start": {
        "after": "l13",
        "gap": 4.51
      }
    },
    {
      "id": "l15",
      "voice": "voice_en_female",
      "text": "Bunzo picked the flower and held it out to Mommy Long Legs.",
      "start": {
        "after": "l14",
        "gap": 0.45
      }
    },
    {
      "id": "l16",
      "speaker": "mommy_long_legs",
      "text": "Oh, it's lovely! But you should keep it, Bunzo. It's your favorite.",
      "emotion": "happy",
      "start": {
        "after": "l15",
        "gap": 0.45
      }
    },
    {
      "id": "l17",
      "speaker": "bunzo",
      "text": "No, I want you to have it. Friends share!",
      "emotion": "happy",
      "start": {
        "after": "l16",
        "gap": 3.97
      }
    },
    {
      "id": "l18",
      "speaker": "mommy_long_legs",
      "text": "Thank you, Bunzo. You are very kind.",
      "emotion": "happy",
      "start": {
        "after": "l17",
        "gap": 0.45
      }
    }
  ],
