  "dialogue": [
    {
      "id": "l1",
      "voice": "voice_en_female",
      "text": "Bunzo the little rabbit loved to play in the sunny park.",
      "start": 4
    },
    {
      "id": "l2",
      "speaker": "bunzo",
      "text": "What a beautiful day! I will hop and play!",
      "emotion": "happy",
      "start": {
        "after": "l1",
        "gap": 0.45
      }
    },
    {
      "id": "l3",
      "voice": "voice_en_female",
      "text": "But Bunzo had heard stories about a tall, long-legged monster in the forest.",
      "start": {
        "after": "l2",
        "gap": 0.45
      }
    },
    {
      "id": "l4",
      "speaker": "bunzo",
      "text": "I am a little scared, but I am brave too!",
      "emotion": "scared",
      "start": {
        "after": "l3",
        "gap": 0.45
      }
    },
    {
      "id": "l5",
      "voice": "voice_en_female",
      "text": "One day, Bunzo decided to go to the forest to see for himself.",
      "start": {
        "after": "l4",
        "gap": 0.45
      }
    },
    {
      "id": "l6",
      "speaker": "bunzo",
      "text": "Here I go! Into the forest!",
      "emotion": "happy",
      "start": {
        "after": "l5",
        "gap": 0.45
      }
    }
