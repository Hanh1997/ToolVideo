  "dialogue": [
    {
      "id": "l7",
      "voice": "voice_en_female",
      "text": "Bunzo hopped along the forest path, looking around carefully.",
      "start": 4
    },
    {
      "id": "l8",
      "speaker": "bunzo",
      "text": "The forest is big and quiet. I hope I don't get lost.",
      "emotion": "scared",
      "start": {
        "after": "l7",
        "gap": 0.45
      }
    },
    {
      "id": "l9",
      "voice": "voice_en_female",
      "text": "Suddenly, a tall figure with very long legs stepped out from behind a tree.",
      "start": {
        "after": "l8",
        "gap": 0.45
      }
    },
    {
      "id": "l10",
      "speaker": "mommy_long_legs",
      "text": "Hello, little rabbit. Why do you look so worried?",
      "start": {
        "after": "l9",
        "gap": 0.45
      }
    },
    {
      "id": "l11",
      "speaker": "bunzo",
      "text": "Oh! You are so tall! Are you the monster?",
      "emotion": "scared",
      "start": {
        "after": "l10",
        "gap": 0.45
      }
    },
    {
      "id": "l12",
      "speaker": "mommy_long_legs",
      "text": "I am Mommy Long Legs. I am not scary. I am a friend.",
      "emotion": "happy",
      "start": {
        "after": "l11",
        "gap": 0.45
      }
    }
  ],
