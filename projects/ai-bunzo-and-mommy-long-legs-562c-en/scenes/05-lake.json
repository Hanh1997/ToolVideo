  "dialogue": [
    {
      "id": "l25",
      "voice": "voice_en_female",
      "text": "In the evening, they went to the clear lake to watch the sunset.",
      "start": 4
    },
    {
      "id": "l26",
      "speaker": "bunzo",
      "text": "The lake is so shiny! Let's dance!",
      "emotion": "happy",
      "start": {
        "after": "l25",
        "gap": 0.45
      }
    },
    {
      "id": "l27",
      "speaker": "mommy_long_legs",
      "text": "I love dancing with you, Bunzo!",
      "emotion": "happy",
      "start": {
        "after": "l26",
        "gap": 0.45
      }
    },
    {
      "id": "l28",
      "voice": "voice_en_female",
      "text": "They danced and laughed as the sun went down.",
      "start": {
        "after": "l27",
        "gap": 0.45
      }
    },
    {
      "id": "l29",
      "speaker": "bunzo",
      "text": "I was scared at first, but now I have a new best friend!",
      "emotion": "happy",
      "start": {
        "after": "l28",
        "gap": 0.45
      }
    },
    {
      "id": "l30",
      "voice": "voice_en_female",
      "text": "And so, Bunzo learned that friends can be tall or small, and kindness is what matters.",
      "start": {
        "after": "l29",
        "gap": 0.45
      }
    }
  ],
