        "gap": 0.45
      }
    },
    {
      "id": "l21",
      "speaker": "mommy_long_legs",
      "text": "Let's have some carrot tea. I picked carrots from my garden.",
      "emotion": "happy",
      "start": {
        "after": "l20",
        "gap": 0.45
      }
    },
    {
      "id": "l22",
      "voice": "voice_en_female",
      "text": "Mommy Long Legs brought two cups of warm carrot tea.",
      "start": {
        "after": "l21",
        "gap": 0.45
      }
    },
    {
      "id": "l23",
      "speaker": "bunzo",
      "text": "This is delicious! Thank you, Mommy.",
      "emotion": "happy",
      "start": {
        "after": "l22",
        "gap": 0.45
      }
    },
    {
      "id": "l24",
      "speaker": "mommy_long_legs",
      "text": "I'm happy you came to visit, little bunny.",
      "emotion": "happy",
      "start": {
