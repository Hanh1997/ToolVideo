  "dialogue": [
    {
      "id": "l1",
      "voice": "voice_vi_female",
      "text": "Buổi sáng, Gấu con cùng bố đi dạo trên bãi biển.",
      "start": 4
    },
    {
      "id": "l2",
      "speaker": "gau_con",
      "text": "Bố ơi, biển đẹp quá! Con thích tiếng sóng vỗ.",
      "emotion": "happy",
      "start": {
        "after": "l1",
        "gap": 0.45
      }
    },
    {
      "id": "l3",
      "speaker": "gau_con",
      "text": "Ôi, bãi biển có nhiều rác quá. Con thấy buồn.",
      "emotion": "sad",
      "start": {
        "after": "l2",
        "gap": 0.45
      }
    },
    {
      "id": "l4",
      "speaker": "gau_bo",
      "text": "Đừng buồn con. Mình cùng nhặt rác để biển sạch nhé!",
      "emotion": "happy",
      "start": {
        "after": "l3",
        "gap": 0.45
      }
    },
    {
      "id": "l5",
      "speaker": "gau_con",
      "text": "Con nhặt chai nhựa này nè!",
      "emotion": "happy",
      "start": {
        "after": "l4",
        "gap": 4.23
      }
    },
    {
      "id": "l6",
      "speaker": "gau_con",
      "text": "Con bỏ chai vào đây để gom lại nhé!",
      "emotion": "happy",
      "start": {
        "after": "l5",
        "gap": 1.95
      }
    },
    {
      "id": "l7",
      "speaker": "gau_bo",
      "text": "Bố cũng nhặt cái lon này!",
      "emotion": "happy",
      "start": {
        "after": "l6",
        "gap": 3.95
      }
    },
    {
      "id": "l8",
      "speaker": "gau_bo",
      "text": "Bỏ lon vào cùng chỗ, bãi biển sạch hơn rồi!",
      "emotion": "happy",
      "start": {
        "after": "l7",
        "gap": 1.95
      }
    }
  ],
