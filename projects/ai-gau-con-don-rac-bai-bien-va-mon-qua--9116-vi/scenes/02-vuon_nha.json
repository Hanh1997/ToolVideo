  "dialogue": [
    {
      "id": "l9",
      "voice": "voice_vi_female",
      "text": "Buổi tối, cả nhà về khu vườn nhỏ.",
      "start": 4
    },
    {
      "id": "l10",
      "speaker": "gau_con",
      "text": "Mẹ ơi, con có món quà tặng mẹ!",
      "emotion": "happy",
      "start": {
        "after": "l9",
        "gap": 3.95
      }
    },
    {
      "id": "l11",
      "speaker": "gau_con",
      "text": "Con tặng mẹ chậu cây xinh này ạ!",
      "emotion": "happy",
      "start": {
        "after": "l10",
        "gap": 8.29
      }
    },
    {
      "id": "l12",
      "speaker": "gau_me",
      "text": "Ôi, chậu cây đẹp quá! Cảm ơn con yêu.",
      "emotion": "surprised",
      "start": {
        "after": "l11",
        "gap": 0.45
      }
    },
    {
      "id": "l13",
      "speaker": "gau_bo",
      "text": "Con của bố mẹ hôm nay đã làm được nhiều việc tốt.",
      "emotion": "happy",
      "start": {
        "after": "l12",
        "gap": 0.45
      }
    },
    {
      "id": "l14",
      "speaker": "gau_con",
      "text": "Con thấy vui vì đã giúp biển sạch và tặng quà cho mẹ.",
      "emotion": "happy",
      "start": {
        "after": "l13",
        "gap": 0.45
      }
    },
    {
      "id": "l15",
      "voice": "voice_vi_female",
      "text": "Đom đóm bay lấp lánh quanh vườn như những vì sao nhỏ.",
      "start": {
        "after": "l14",
        "gap": 0.45
      }
    },
    {
      "id": "l16",
      "speaker": "gau_me",
      "text": "Cả nhà mình cùng ngắm đom đóm nhé!",
      "emotion": "happy",
      "start": {
        "after": "l15",
        "gap": 0.45
      }
    }
  ],
