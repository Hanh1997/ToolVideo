  "dialogue": [
    {
      "id": "l1",
      "speaker": "gau",
      "text": "Các bạn ơi, hôm nay rừng mình họp khẩn cấp nhé!",
      "start": 4.6,
      "duration": 2.612,
      "file": "tts/53037e48d15dc9ad1d953ab6.wav",
      "voice": "voice_vi_deep",
      "rate": 0.85,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l2",
      "speaker": "huou",
      "text": "Bác Gấu Trúc ơi, nước ao dạo này đục ngầu và có mùi lạ quá ạ.",
      "start": 7.662,
      "duration": 3.587,
      "file": "tts/7c9831c19e29a91f85cb597b.wav",
      "voice": "voice_vi_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l3",
      "speaker": "cua",
      "text": "Nhà cháu ở ngay bờ ao, rác trôi về đầy cả hang rồi!",
      "start": 11.699,
      "duration": 2.961,
      "file": "tts/5ac829e386bee9050845f612.wav",
      "voice": "voice_vi_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l4",
      "speaker": "ga",
      "text": "Uống phải nước bẩn, các em gà con bị đau bụng hết cả!",
      "start": 15.11,
      "duration": 2.728,
      "file": "tts/7b5f9055a79782d7c786d182.wav",
      "voice": "voice_vi_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l5",
      "speaker": "heo",
      "text": "Cháu thấy có người vứt chai nhựa và túi ni lông xuống ao.",
      "start": 18.288,
      "duration": 2.821,
      "file": "tts/bf473f44aff4ee3eb6147071.wav",
      "voice": "voice_vi_low",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l6",
      "speaker": "gau",
      "text": "Nếu nguồn nước bị ô nhiễm, cây cối và muông thú đều sẽ bị ốm.",
      "start": 21.559,
      "duration": 3.32,
      "file": "tts/dbd2a51901a75c8f01068c87.wav",
      "voice": "voice_vi_deep",
      "rate": 0.85,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l7",
      "speaker": "huou",
      "text": "Vậy chúng ta phải làm gì bây giờ ạ?",
      "start": 25.329,
      "duration": 1.811,
      "file": "tts/bf0e0314ad0f549a8e179fc1.wav",
      "voice": "voice_vi_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l8",
      "speaker": "gau",
      "text": "Chúng ta cùng nhặt rác, và nhắc mọi người không xả rác xuống ao.",
      "start": 27.59,
      "duration": 3.193,
      "file": "tts/5067e126c20130e4b622b12f.wav",
      "voice": "voice_vi_deep",
      "rate": 0.85,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l9",
      "speaker": "cua",
      "text": "Cháu sẽ dọn rác dưới nước!",
      "start": 31.233,
      "duration": 1.382,
      "file": "tts/7daaecc052a21a7fdab742e0.wav",
      "voice": "voice_vi_squeaky",
      "rate": 1,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l10",
      "speaker": "ga",
      "text": "Còn cháu sẽ đi nhắc cả làng!",
      "start": 33.065,
      "duration": 1.312,
      "file": "tts/43f10afca0b80bd9654fa1a0.wav",
      "voice": "voice_vi_child",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l11",
      "speaker": "heo",
      "text": "Cháu sẽ trồng thêm cây quanh ao!",
      "start": 34.827,
      "duration": 1.556,
      "file": "tts/355f4b64137cdadcb56e3485.wav",
      "voice": "voice_vi_low",
      "rate": 0.95,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l12",
      "speaker": "gau",
      "text": "Hay lắm! Giữ nước sạch là giữ gìn sự sống. Cả rừng cùng làm nhé!",
      "start": 36.833,
      "duration": 3.461,
      "file": "tts/233814aa15e0894ef5de2fcd.wav",
      "voice": "voice_vi_deep",
      "rate": 0.85,
      "volume": 1,
      "subtitle": true
    },
    {
      "id": "l13",
      "text": "Các bạn nhỏ ơi, hãy cùng nhau bảo vệ nguồn nước nhé!",
      "start": 40.894,
      "duration": 2.67,
      "file": "tts/4830ad75951a0f3ac9b68115.wav",
      "voice": "voice_vi_female",
      "rate": 0.9,
      "volume": 1,
      "subtitle": true
    }
  ],
