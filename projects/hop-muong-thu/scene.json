    { "id": "huou", "name": "Hươu", "asset": "char_m_deer", "position": { "x": -9, "y": 0, "z": -4 }, "heading": 50, "voice": "voice_vi_female" },
    { "id": "cua", "name": "Cua", "asset": "char_m_crab", "position": { "x": -4, "y": 0, "z": 8 }, "heading": 150, "voice": "voice_vi_squeaky" },
    { "id": "ga", "name": "Gà", "asset": "char_m_chicken", "position": { "x": 7, "y": 0, "z": -5 }, "heading": -45, "voice": "voice_vi_child" },
