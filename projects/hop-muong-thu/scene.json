  "camera": { "mode": "fixed", "position": { "x": 0, "y": 2.4, "z": -4.2 }, "lookAt": { "x": 0, "y": 0.7, "z": 3.2 }, "fov": 50 },
  "subtitles": { "burnIn": true, "size": 0.05, "position": "bottom", "showSpeaker": true },
  "mix": { "duckMusic": true, "duckLevel": 0.25, "loudness": -14 },

  "dialogue": [
    { "id": "l1", "speaker": "gau", "text": "Các bạn ơi, hôm nay rừng mình họp khẩn cấp nhé!", "start": 4.6 },
    { "id": "l2", "speaker": "huou", "text": "Bác Gấu Trúc ơi, nước ao dạo này đục ngầu và có mùi lạ quá ạ.", "start": { "after": "l1", "gap": 0.45 } },
    { "id": "l3", "speaker": "cua", "text": "Nhà cháu ở ngay bờ ao, rác trôi về đầy cả hang rồi!", "start": { "after": "l2", "gap": 0.45 } },
    { "id": "l4", "speaker": "ga", "text": "Uống phải nước bẩn, các em gà con bị đau bụng hết cả!", "start": { "after": "l3", "gap": 0.45 } },
    { "id": "l5", "speaker": "heo", "text": "Cháu thấy có người vứt chai nhựa và túi ni lông xuống ao.", "start": { "after": "l4", "gap": 0.45 } },
    { "id": "l6", "speaker": "gau", "text": "Nếu nguồn nước bị ô nhiễm, cây cối và muông thú đều sẽ bị ốm.", "start": { "after": "l5", "gap": 0.45 } },
    { "id": "l7", "speaker": "huou", "text": "Vậy chúng ta phải làm gì bây giờ ạ?", "start": { "after": "l6", "gap": 0.45 } },
    { "id": "l8", "speaker": "gau", "text": "Chúng ta cùng nhặt rác, và nhắc mọi người không xả rác xuống ao.", "start": { "after": "l7", "gap": 0.45 } },
    { "id": "l9", "speaker": "cua", "text": "Cháu sẽ dọn rác dưới nước!", "start": { "after": "l8", "gap": 0.45 } },
    { "id": "l10", "speaker": "ga", "text": "Còn cháu sẽ đi nhắc cả làng!", "start": { "after": "l9", "gap": 0.45 } },
    { "id": "l11", "speaker": "heo", "text": "Cháu sẽ trồng thêm cây quanh ao!", "start": { "after": "l10", "gap": 0.45 } },
    { "id": "l12", "speaker": "gau", "text": "Hay lắm! Giữ nước sạch là giữ gìn sự sống. Cả rừng cùng làm nhé!", "start": { "after": "l11", "gap": 0.45 } },
    { "id": "l13", "text": "Các bạn nhỏ ơi, hãy cùng nhau bảo vệ nguồn nước nhé!", "voice": "voice_vi_female", "start": { "after": "l12", "gap": 0.6 } }
  ],

