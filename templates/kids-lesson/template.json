{
  "version": 1,
  "id": "kids-lesson",
  "name": "Bài học thiếu nhi (nhân vật dẫn chuyện)",
  "description": "Nhân vật chào, giảng 2–3 câu, khen ngợi. Cử chỉ khớp từng câu, camera cận ở câu cuối, nhạc nền tự giảm khi nói, phụ đề in lên hình.",

  "params": {
    "title":       { "type": "string", "maxLength": 80, "description": "Tên video" },
    "character":   { "type": "asset", "assetType": "character", "default": "char_robot", "description": "Nhân vật dẫn chuyện (id trong Registry)" },
    "voice":       { "type": "asset", "assetType": "voice", "default": "voice_vi_female" },
    "environment": { "type": "asset", "assetType": "environment", "default": "env_park", "description": "Bối cảnh (id trong Registry)" },
    "sky":         { "type": "color", "default": "#a8d8f0", "description": "Màu trời / sương mù" },
    "greeting":    { "type": "string", "maxLength": 200, "description": "Câu chào (kèm vẫy tay)" },
    "line_2":      { "type": "string", "maxLength": 200 },
    "line_3":      { "type": "string", "maxLength": 200 },
    "line_4":      { "type": "string", "maxLength": 200, "required": false, "description": "Câu kết (tùy chọn, kèm nhảy múa)" },
    "gesture_2":   { "type": "string", "enum": ["yes", "no", "wave", "thumbsup", "victory", "dance", "jump", "idle"], "default": "yes" },
    "gesture_3":   { "type": "string", "enum": ["yes", "no", "wave", "thumbsup", "victory", "dance", "jump", "idle"], "default": "thumbsup" },
    "music_volume":{ "type": "number", "min": 0, "max": 1.5, "default": 0.5 }
  },

  "formats": {
    "16x9": { "width": 1280, "height": 720 },
    "9x16": {
      "width": 1080,
      "height": 1920,
      "overrides": {
        "camera": { "position": { "x": 0.5, "y": 1.35, "z": -1.9 }, "lookAt": { "x": 0, "y": 0.95, "z": 2 }, "fov": 55 },
        "subtitles": { "size": 0.032 }
      },
      "actions": {
        "cam_close": { "shot": { "position": { "x": 0.3, "y": 1.25, "z": -0.4 }, "lookAt": { "x": 0, "y": 1.0, "z": 2 }, "fov": 50 } },
        "cam_close_4": { "shot": { "position": { "x": 0.3, "y": 1.25, "z": -0.4 }, "lookAt": { "x": 0, "y": 1.0, "z": 2 }, "fov": 50 } }
      }
    }
  },

  "scene": {
    "version": 1,
    "meta": { "name": "{{title}}", "duration": "auto", "tail": 1.5, "fps": 30, "width": 1280, "height": 720 },
    "environment": { "asset": "{{environment}}", "background": "{{sky}}", "fog": { "color": "{{sky}}", "near": 30, "far": 70 } },
    "characters": [
      { "id": "host", "asset": "{{character}}", "position": { "x": 0, "y": 0, "z": 2 }, "heading": 180, "voice": "{{voice}}" }
    ],
    "props": [{ "id": "log", "asset": "prop_log", "position": { "x": 1.8, "y": 0, "z": 3 }, "heading": 30 }],
    "camera": { "mode": "fixed", "position": { "x": 1.2, "y": 1.7, "z": -3.2 }, "lookAt": { "x": 0, "y": 1.1, "z": 2 }, "fov": 45 },
    "subtitles": { "burnIn": true, "size": 0.055, "position": "bottom" },
    "mix": { "duckMusic": true, "duckLevel": 0.3, "loudness": -14 },

    "dialogue": [
      { "id": "l1", "speaker": "host", "text": "{{greeting}}", "start": 0.6 },
      { "id": "l2", "speaker": "host", "text": "{{line_2}}", "start": { "after": "l1", "gap": 0.5 } },
      { "id": "l3", "speaker": "host", "text": "{{line_3}}", "start": { "after": "l2", "gap": 0.5 } },
      { "$if": "line_4", "id": "l4", "speaker": "host", "text": "{{line_4}}", "start": { "after": "l3", "gap": 0.6 } }
    ],

    "actions": [
      { "id": "anim_greet", "type": "animation", "target": "host", "clip": "wave", "loop": false, "sync": { "line": "l1", "offset": -0.3, "pad": 0.2 } },
      { "id": "anim_2", "type": "animation", "target": "host", "clip": "{{gesture_2}}", "sync": { "line": "l2" } },
      { "id": "anim_3", "type": "animation", "target": "host", "clip": "{{gesture_3}}", "loop": false, "sync": { "line": "l3", "pad": 0.3 } },
      { "$if": "line_4", "id": "anim_4", "type": "animation", "target": "host", "clip": "dance", "sync": { "line": "l4", "pad": 0.8 } },
      {
        "$if": "!line_4",
        "id": "cam_close",
        "type": "camera",
        "sync": { "line": "l3", "offset": -0.2, "pad": 30 },
        "shot": { "mode": "fixed", "position": { "x": 0.7, "y": 1.35, "z": -0.9 }, "lookAt": { "x": 0, "y": 0.95, "z": 2 }, "fov": 42 }
      },
      {
        "$if": "line_4",
        "id": "cam_close_4",
        "type": "camera",
        "sync": { "line": "l4", "offset": -0.2, "pad": 30 },
        "shot": { "mode": "fixed", "position": { "x": 0.7, "y": 1.35, "z": -0.9 }, "lookAt": { "x": 0, "y": 0.95, "z": 2 }, "fov": 42 }
      }
    ],

    "audio": [
      { "id": "bgm", "kind": "music", "asset": "music_happy", "start": 0, "loop": true, "volume": "{{music_volume}}", "fadeIn": 0.3, "fadeOut": 1.2 },
      { "$if": "!line_4", "id": "sfx_end", "kind": "sfx", "asset": "sfx_chime", "sync": { "line": "l3", "at": "end", "offset": 0.1 }, "volume": 0.8 },
      { "$if": "line_4", "id": "sfx_end_4", "kind": "sfx", "asset": "sfx_chime", "sync": { "line": "l4", "at": "end", "offset": 0.1 }, "volume": 0.8 }
    ]
  }
}
