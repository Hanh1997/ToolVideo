{
  "name": "autocartoon-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets:generate": "tsx scripts/generate-demo-assets.ts && tsx scripts/generate-demo-audio.ts",
    "render": "tsx cli/render.ts",
    "batch": "tsx cli/batch.ts",
    "asset:add": "tsx scripts/asset-add.ts",
    "asset:set": "tsx scripts/asset-set.ts",
    "env:compose": "tsx scripts/compose-environment.ts",
    "audio:add": "tsx scripts/audio-add.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
